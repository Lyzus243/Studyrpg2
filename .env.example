# ── App ──────────────────────────────────────────────
SECRET_KEY=your_super_secret_key_here_min_32_chars
JWT_ALGO=HS256
JWT_EXPIRE_MIN=30
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=false
BASE_URL=http://127.0.0.1:8000
API_URL=http://localhost:8000

# ── Database ─────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./app.db

# ── AI features (practice tests, analysis, recommendations) ──
OPENAI_API_KEY=sk-your-real-openai-key-here

# ── Email (Resend — used for verification/reset links) ────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=StudyRPG <noreply@yourdomain.com>
FRONTEND_URL=http://localhost:8000

# ── Dev Mode: prints verification/reset links to the console
# instead of actually sending email. Set to false in production.
DEV_MODE=true

# ── Legacy mail config (app/config.py loads these at import
# time even though Resend is what's actually used to send
# email — leave as placeholders if you don't use this path) ──
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_FROM=noreply@yourdomain.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM_NAME=StudyRPG

# ── Admin ─────────────────────────────────────────────
ADMIN_USERNAME=Lyzus308
ADMIN_PASSWORD=your_admin_password
ADMIN_EMAIL=admin@yourdomain.com
